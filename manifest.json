{
  "manifest_version": 3,
  "name": "Fazenda viewer • F18",
  "version": "1.3.2",
  "description": "Ferramenta independente para A Fazenda 18: atalhos entre seis sinais e mosaico flutuante ou lado a lado no RecordPlus.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.recordplus.com/*",
    "https://recordplus.com/*"
  ],
  "action": {
    "default_title": "Abrir Fazenda viewer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.recordplus.com/*",
        "https://recordplus.com/*"
      ],
      "js": [
        "viewer-ui.js",
        "toolbar.js",
        "transition.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/Teko-Bold.ttf"],
      "matches": ["https://www.recordplus.com/*", "https://recordplus.com/*"]
    }
  ]
}
